@startuml UML类图
title Campus Second-Hand Trading System - Class Diagram
skinparam class {
    BackgroundColor #f8f8f8
    BorderColor black
}
skinparam linetype ortho
skinparam packageStyle rectangle

package Account {
    class User {
        - userId: String
        - studentId: String
        - email: String
        - passwordHash: String
        - role: String
        - accountStatus: String
        + login(): Boolean
    }
}

package "Product Management" {
    class Product {
        - productId: String
        - title: String
        - category: String
        - price: Decimal
        - status: String
        + saveDraft(): void
        + submitForReview(): void
    }

    class ProductRevision {
        - revisionId: String
        - proposedContent: String
        - status: String
        + submitForReview(): void
    }

    class ProductReview {
        - reviewId: String
        - result: String
        - rejectionReason: String
        + approve(): void
        + reject(): void
    }

    class Appeal {
        - appealId: String
        - reason: String
        - status: String
        + submit(): void
    }
}

package "Reservation and Transaction" {
    class Reservation {
        - reservationId: String
        - status: String
        - createdAt: DateTime
        + create(): void
        + confirmBySeller(): void
        + cancelByBuyer(): void
    }

    class TransactionRecord {
        - transactionId: String
        - finalPrice: Decimal
        - completedAt: DateTime
    }
}

package Messaging {
    class ChatSession {
        - sessionId: String
        - buyerId: String
        - sellerId: String
    }
    class ChatMessage {
        - messageId: String
        - messageType: String
        - content: String
        - imageUrl: String
        + send(): void
    }
}

' ========= 关联 =========
' 卖家发布商品
User "1" -- "0..*" Product : sells

' 买家发起预约（把buys从Product改到Reservation，语义更合理）
User "1" -- "0..*" Reservation : buys

' 商品聚合版本、审核、申诉记录
Product "1" o-- "0..*" ProductRevision : revisions
Product "1" o-- "0..*" ProductReview : reviews
Product "1" o-- "0..*" Appeal : appeals

' 商品关联聊天会话
Product "1" -- "0..*" ChatSession : chats

' 会话组合消息（实心菱形）
ChatSession "1" *-- "0..*" ChatMessage : messages

' 预约生成交易记录
Reservation "1" -- "0..1" TransactionRecord : result

' 用户与会话：一个会话包含买家、卖家两个用户
User "1" -- "0..*" ChatSession : as buyer
User "1" -- "0..*" ChatSession : as seller

@enduml
