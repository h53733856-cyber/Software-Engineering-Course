
@startuml UML时序图

title Campus Second-Hand Trading System - Reservation Sequence

hide footbox
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam responseMessageBelowArrow false
skinparam sequenceMessageAlign center

skinparam sequence {
    ArrowColor #64748B
    LifeLineBorderColor #94A3B8
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #64748B
    ParticipantBackgroundColor #EFF4F9
    ParticipantFontColor #1E293B
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupHeaderFontColor #334155
}

actor Buyer
boundary "Web UI" as UI
control "Reservation Service" as RS
control "Product Service" as PS
database "Database" as DB

Buyer -> UI : Click Reserve
UI -> RS : reserve(productId, requestKey)
activate RS

RS -> DB : Check buyer / seller accounts
DB --> RS : Eligibility result

alt Account blocked
    RS --> UI : Reject request
else Accounts eligible
    RS -> PS : Check product availability
    PS -> DB : Read product state
    DB --> PS : Product state
    PS --> RS : Availability result

    alt Product unavailable
        RS --> UI : Reject request
    else Product appears available
        group Atomic reservation transaction
            RS -> DB : Lock product; recheck state,\naccounts and requestKey
            DB --> RS : Current data

            alt Duplicate request
                RS -> DB : Rollback
                RS --> UI : Return existing status
            else Conflict or unavailable
                RS -> DB : Rollback
                RS --> UI : Reject (already reserved)
            else Available
                RS -> DB : Create reservation (WAITING_SELLER)\nand set product RESERVED
                RS -> DB : Commit
                DB --> RS : reservationId
                RS --> UI : Reservation successful
            end
        end
    end
end

deactivate RS
UI --> Buyer : Display result

@enduml
