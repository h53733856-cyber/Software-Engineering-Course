@startuml UML用例图
title Campus Second-Hand Trading System - Use Case Diagram
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam dpi 160
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 48
skinparam roundcorner 10
skinparam ArrowColor #94A3B8

skinparam actor {
    BorderColor #475569
    FontColor #334155
}

skinparam usecase {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontColor #1E293B
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #B8C6D6
    FontColor #334155
}

actor "Campus User\n(Buyer & Seller)" as CampusUser
actor "Administrator" as Admin

rectangle "Campus Second-Hand Trading System" as System {
    rectangle "USER SERVICES" as UserServices #F8FAFC {
        usecase "Register / Sign In\n& Verify Campus Email" as U1
        usecase "Browse & Search\nProducts" as U2
        usecase "Publish / Manage\nListings & Appeals" as U3
        usecase "Contact Seller\n(Text & Images)" as U4
        usecase "Create & Manage\nReservations" as U5
        usecase "Confirm Trade\nOutcome" as U6
        usecase "View Personal\nRecords" as U7
    }

    rectangle "PLATFORM ADMINISTRATION" as Administration #F8FAFC {
        usecase "Review Product\nSubmissions" as A1
        usecase "Handle Violations\n& Appeals" as A2
        usecase "Manage User\nAccounts & Roles" as A3
        usecase "Resolve Disputed\nReservations" as A4
        usecase "View Logs\n& Statistics" as A5
    }
}

' 关联：左下用户连左边用户用例，右下管理员连右边管理用例
CampusUser -- U1
CampusUser -- U2
CampusUser -- U3
CampusUser -- U4
CampusUser -- U5
CampusUser -- U6
CampusUser -- U7

Admin -- A1
Admin -- A2
Admin -- A3
Admin -- A4
Admin -- A5

@enduml
